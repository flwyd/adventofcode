# Advent of Code 2023 day 1
# Read the puzzle at https://adventofcode.com/2023/day/1
# Wrapper for day1.sed, which outputs a list of numbers preceded by + signs.
# Prepends "__part2__" to the input for part2.

source ${0:a:h:h:h}/lang/zsh/runner.zsh
((VERBOSE=0))
if [[ $1 == "-v" ]]; then
  ((VERBOSE=1))
  shift
fi
DAY=day1
DAYDIR=${0:h}

function solve {
  local inputfile=$1
  PART1=$(( 0 $(sed -f $DAYDIR/day1.sed $inputfile) ))
  PART2=$(( 0 $({echo __part2__; cat $inputfile} | sed -f $DAYDIR/day1.sed) ))
}

runner_solve_files $@
exit $(($FAILURES > 0))
