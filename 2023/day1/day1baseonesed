# Advent of Code 2023 day 1
# Read the puzzle at https://adventofcode.com/2023/day/1
# Wrapper for day1baseone.sed, with and without adding a "bpart2" selector.

source ${0:a:h:h:h}/lang/zsh/runner.zsh
((VERBOSE=0))
if [[ $1 == "-v" ]]; then
  ((VERBOSE=1))
  shift
fi
DAY=day1
DAYDIR=${0:h}

function solve {
  local inputfile=$1
  prog=$DAYDIR/day1baseone.sed
  PART1=$(sed -n -f $prog $inputfile)
  PART2=$(sed -n -e 'bpart2' -f $prog $inputfile)
}

runner_solve_files $@
exit $(($FAILURES > 0))
