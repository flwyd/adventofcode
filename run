# Runs an Advent of Code program, with interpreter determined by filename.
# Usage: run [-v] day0/day0.awk day0/input.example.txt day0/input.actual.txt
# run day0/day0.lang checks for a runner script of the form day0/day0lang.sh
# and uses that if the language doesn't have special support.  If no runner
# script is found, the named file must be executable.

if [[ $1 == -v ]]; then
  verbose=(-v)
  shift
else
  verbose=()
fi

if (( $# == 0 )); then
  print -u 2 "Usage: $0 2001/day1/file 2001/day1/input.example.txt ..."
  exit 1
fi

program="$1"
shift
if [[ ! -f "$program" ]]; then
  print -u 2 "$program file not found"
  exit 1
fi
daydir=${program:h}
langdir=${0:h}/lang
runner=${program:t:r}${program:e}

# Environment variables for some languages
export RAKULIB=${0:h:a}/lang/raku
export RUST_BACKTRACE=1

# make if needed
if [[ -f $daydir/Makefile ]]; then
  case $program in
    (*)
      if make -n -C $daydir bin/$runner > /dev/null 2>&1 ; then
        maketarget=bin/$runner
      fi
      ;;
  esac
  if [[ ! -z $maketarget ]]; then
    make --quiet -C $daydir $maketarget || exit $!
  fi
fi

case "$program" in
  (*.awk) cmd=(gawk --lint=no-ext -i $langdir/awk/runner.gawk -f $program -- $verbose) ;;
  (*.fs) cmd=(gforth -e "${#verbose} constant verbose" $program -e bye) ;;
  (*.go) cmd=(go run $program ${program:h}/runner.go $verbose) ;;
  (*.jq) cmd=($langdir/jq/runjq $verbose $program) ;;
  (*.jsonnet) cmd=($langdir/jsonnet/runjsonnet $verbose $program) ;;
  (*)
    if [[ -x "$daydir/$runner" ]]; then
      cmd=("$daydir/$runner" $verbose)
    elif [[ -x "$daydir/bin/$runner" ]]; then
      cmd=("$daydir/bin/$runner" $verbose)
    elif [[ -x "$program" ]]; then
      cmd=("$program" $verbose)
    else
      print -u 2 "Don't know how to run $program"
      exit 1
    fi
    ;;
esac

exec $cmd "$@"
